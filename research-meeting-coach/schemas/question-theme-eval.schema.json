{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-meeting-coach:schema:question-theme-eval:1.0",
  "title": "Advisor Question Theme Evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "synthetic", "taxonomy_version", "annotation_source", "predictions", "actual_questions"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "synthetic": {"type": "boolean"},
    "taxonomy_version": {"type": "string", "minLength": 1},
    "annotation_source": {"type": "string", "minLength": 1},
    "predictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["theme_id", "rank", "risk"],
        "properties": {
          "theme_id": {"type": "string", "minLength": 1},
          "rank": {"type": "integer", "minimum": 1},
          "risk": {"enum": ["Critical", "High", "Medium", "Low"]}
        }
      }
    },
    "actual_questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "theme_ids"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "theme_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
