{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-meeting-coach:schema:question-theme-taxonomy:1.0",
  "title": "Frozen Advisor Question Theme Taxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": ["taxonomy_version", "freeze_rule", "themes"],
  "properties": {
    "taxonomy_version": {"type": "string", "minLength": 1},
    "freeze_rule": {"type": "string", "minLength": 1},
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["theme_id", "definition", "include", "exclude", "example"],
        "properties": {
          "theme_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "definition": {"type": "string", "minLength": 1},
          "include": {"type": "string", "minLength": 1},
          "exclude": {"type": "string", "minLength": 1},
          "example": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
